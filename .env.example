# 正式環境必填。留空時網站以本機示範模式運作。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 新版 Supabase publishable key 也可填在下一行，程式會在 anon key 空白時改用它。
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 沒有這把金鑰時，報名確認與提醒只會略過，不會讓網站壞掉。
RESEND_API_KEY=
# RESEND_FROM=健康俱樂部 <noreply@example.com>

# 本機：http://127.0.0.1:43123　正式網址由公司決定後再填
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# 每日提醒排程用。Vercel Cron 會帶 Authorization: Bearer <這組值>
CRON_SECRET=

# LINE Login。兩行都留空時，綠色按鈕走示範登入，不會連到 LINE。
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
